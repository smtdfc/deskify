<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground drawable for the adaptive launcher icon.
  A 108dp canvas with a monitor + taskbar silhouette in the brand
  accent color. The 66dp "safe zone" in the center is where the
  system crops the icon for round / squircle masks.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Monitor body (rounded rectangle). -->
    <path
        android:fillColor="#3B7BF6"
        android:pathData="M28,28 h52 a4,4 0 0 1 4,4 v32 a4,4 0 0 1 -4,4 h-52 a4,4 0 0 1 -4,-4 v-32 a4,4 0 0 1 4,-4 z" />
    <!-- Monitor screen (cutout). -->
    <path
        android:fillColor="#0B0F1A"
        android:pathData="M32,32 h44 a2,2 0 0 1 2,2 v24 a2,2 0 0 1 -2,2 h-44 a2,2 0 0 1 -2,-2 v-24 a2,2 0 0 1 2,-2 z" />
    <!-- Taskbar (a horizontal bar at the bottom of the screen). -->
    <path
        android:fillColor="#E8EAF0"
        android:pathData="M32,52 h44 v4 h-44 z" />
    <!-- Stand. -->
    <path
        android:fillColor="#3B7BF6"
        android:pathData="M48,70 h12 v4 h-12 z" />
    <path
        android:fillColor="#3B7BF6"
        android:pathData="M40,74 h28 v4 a2,2 0 0 1 -2,2 h-24 a2,2 0 0 1 -2,-2 z" />
</vector>
