<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data-extraction rules. Mirrors the backup_rules.xml
  above; the two files are required by the manifest's
  android:fullBackupContent / android:dataExtractionRules attributes.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="database" path="deskify.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="database" path="deskify.db" />
    </device-transfer>
</data-extraction-rules>
